{
  "version": 1,
  "schemeName": "示例方案（W+右键）",
  "trigger": {
    "key": "C",
    "mode": "once",
    "holdLoopInterval": 300
  },
  "exitKey": "X",
  "timing": {
    "globalSpeed": 1.0,
    "stepJitter": 0,
    "holdDuration": null,
    "disableNutAutoDelay": true
  },
  "steps": [
    {
      "type": "pressKey",
      "key": "W",
      "hold": true,
      "holdDuration": null,
      "interval": { "mode": "fixed", "value": 0 }
    },
    {
      "type": "randomDelay",
      "min": 106,
      "max": 194,
      "interval": { "mode": "fixed", "value": 0 }
    },
    {
      "type": "mouseClick",
      "button": "right",
      "interval": { "mode": "fixed", "value": 0 }
    },
    {
      "type": "randomDelay",
      "min": 103,
      "max": 197,
      "interval": { "mode": "fixed", "value": 0 }
    },
    {
      "type": "releaseKey",
      "key": "W",
      "interval": { "mode": "fixed", "value": 0 }
    }
  ]
}
